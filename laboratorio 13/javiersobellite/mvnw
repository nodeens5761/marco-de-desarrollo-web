#!/bin/sh
set -eu

MAVEN_VERSION="3.9.11"
MAVEN_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.zip"
CACHE_ROOT="${MAVEN_USER_HOME:-${HOME}/.m2}/wrapper/dists"
MAVEN_HOME="${CACHE_ROOT}/apache-maven-${MAVEN_VERSION}"

if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
fi

if [ ! -x "${MAVEN_HOME}/bin/mvn" ]; then
    mkdir -p "${CACHE_ROOT}"
    TEMP_DIR="$(mktemp -d)"
    trap 'rm -rf "${TEMP_DIR}"' EXIT
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL "${MAVEN_URL}" -o "${TEMP_DIR}/maven.zip"
    elif command -v wget >/dev/null 2>&1; then
        wget -q "${MAVEN_URL}" -O "${TEMP_DIR}/maven.zip"
    else
        printf '%s\n' 'Se necesita curl o wget para descargar Maven.' >&2
        exit 1
    fi
    unzip -q "${TEMP_DIR}/maven.zip" -d "${TEMP_DIR}"
    mv "${TEMP_DIR}/apache-maven-${MAVEN_VERSION}" "${MAVEN_HOME}"
fi

exec "${MAVEN_HOME}/bin/mvn" "$@"
